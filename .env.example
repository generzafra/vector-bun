NODE_ENV=development
DATABASE_URL=postgres://vector:vector@127.0.0.1:5436/vector
REDIS_URL=redis://127.0.0.1:6382
SESSION_COOKIE=vector_sid
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
CONTROL_ORIGIN=http://localhost:5183
DELIVERY_ORIGIN=http://localhost:5184
DELIVERY_PREVIEW_PARENT_HOST=localhost
API_ORIGIN=http://localhost:3011
SEED_ADMIN_EMAIL=admin@vector.test
SEED_ADMIN_PASSWORD=ChangeMeNow!vector
SEED_USER_A_EMAIL=usera@vector.test
SEED_USER_A_PASSWORD=ChangeMeNow!vector-a
STORAGE_LOCAL_DIR=.data/storage
# Optional Cloudflare R2. When unset, Vector uses local tenant-scoped files.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=
# Optional PostHog. Postgres remains the source of truth for leads and outcomes.
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
