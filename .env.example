NODE_ENV=development
DATABASE_URL=postgres://vector:vector@127.0.0.1:5436/vector
REDIS_URL=redis://127.0.0.1:6382
SESSION_COOKIE=vector_sid
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
CONTROL_ORIGIN=http://localhost:5183
DELIVERY_ORIGIN=http://localhost:5184
DELIVERY_PREVIEW_PARENT_HOST=localhost
API_ORIGIN=http://localhost:3011
SEED_ADMIN_EMAIL=admin@vector.test
SEED_ADMIN_PASSWORD=ChangeMeNow!vector
SEED_USER_A_EMAIL=usera@vector.test
SEED_USER_A_PASSWORD=ChangeMeNow!vector-a
STORAGE_LOCAL_DIR=.data/storage
# Optional Cloudflare R2. When unset, Vector uses local tenant-scoped files.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=
# Optional PostHog. Postgres remains the source of truth for leads and outcomes.
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# Optional Resend. When unset, Vector uses the in-process memory adapter.
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=
# EMAIL_UNSUBSCRIBE_SECRET=vector-unsubscribe-test-secret
# EMAIL_SENDING_PAUSED=false
# Optional Trigger.dev. When unset, Phase 3 workflows run in-process.
# TRIGGER_SECRET_KEY=
# TRIGGER_PROJECT_REF=
# TRIGGER_API_URL=
# Optional xAI Grok. When unset, Vector uses the in-process memory AI adapter.
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL_DEFAULT=grok-3-mini
# XAI_MODEL_RESEARCH=grok-4
# AI_EXECUTION_PAUSED=false
# AI_COST_CEILING_MICROS=5000000
# IMAGE_GENERATION_PAUSED=false
# VIDEO_GENERATION_PAUSED=false
# IMAGE_COST_CEILING_MICROS=5000000
# IMAGE_COST_PER_IMAGE_MICROS=40000
# XAI_IMAGE_MODEL=grok-imagine-image-2.0
# TOKEN_ENCRYPTION_KEY=vector-token-encryption-test-key-32
# SOCIAL_ADAPTER=memory
# SOCIAL_PUBLISHING_PAUSED=false
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# META_APP_ID=
# META_APP_SECRET=
# SOCIAL_OAUTH_REDIRECT_URI=http://localhost:5183/social/oauth/callback
# SEARCH_ADAPTER=memory
